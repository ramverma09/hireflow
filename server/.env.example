NODE_ENV=development
PORT=7777
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/hireflow?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_DAYS=7